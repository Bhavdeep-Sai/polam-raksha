# PolamRaksha Environment Configuration (Template)
# Copy to .env and replace placeholder values before running locally.

# Application
APP_NAME=PolamRaksha
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security (Replace JWT_SECRET_KEY with a strong random value in .env)
JWT_SECRET_KEY=change-me-in-local-env-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL
POSTGRES_USER=polamraksha
POSTGRES_PASSWORD=polamraksha_dev_pass
POSTGRES_DB=polamraksha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://polamraksha:polamraksha_dev_pass@localhost:5432/polamraksha

# Worker & Demo Mode
WORKER_POLL_INTERVAL_SECONDS=10
DEMO_MODE_ENABLED=true
DEMO_AUCTION_DURATION_SECONDS=120
ENABLE_DEMO_SEED=true

# Optional External Services (leave empty for offline/local fallbacks)
OSRM_BASE_URL=
DATA_GOV_IN_API_KEY=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_DEFAULT_LOCALE=te

